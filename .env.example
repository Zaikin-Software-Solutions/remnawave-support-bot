# Telegram
BOT_TOKEN=123456789:AA-replace-with-token-from-BotFather
# Ваш Telegram user ID (узнать через @userinfobot). Все сообщения клиентов будут форвардиться сюда.
OWNER_TG_ID=000000000

# Remnawave API
REMNAWAVE_BASE_URL=https://your-panel.example.com
# API-токен из админки Remnawave (Settings → API Tokens) ИЛИ Bearer-токен.
REMNAWAVE_API_TOKEN=replace-with-remnawave-api-token

# База данных (внутри контейнера). Снаружи это том ./data.
DB_PATH=/data/bot.db

# Текст, который бот шлёт клиенту сразу после его сообщения.
# Можно переопределить через env, иначе будет дефолт из app/config.py.
AUTOREPLY_TEXT=Принято! Администратор скоро вернётся с обратной связью.
